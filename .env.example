ALPACA_API_KEY_ID=your_alpaca_key_id
ALPACA_API_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=IEX
ALPACA_DATA_OVERRIDE_IP=
ALPACA_CA_BUNDLE=
ALPACA_VERIFY_TLS=1
ALPACA_PAPER_ACCOUNT=1  # RECOMMENDED: set to 1 for paper trading. Set to 0 ONLY for live trading with real money
ALPACA_OAUTH_TOKEN=
ENABLE_UNDERLYING_BARS=1
USE_ALPACA_OPTION_CHAIN=1
ENABLE_OPTION_AGGREGATES=1  # Enable Alpaca option bars for better signal quality
OPTION_METRICS_LIMIT=300
MAX_OPTION_SPREAD_PCT=0.25  # Maximum bid/ask spread as fraction of price (0.25 = 25%)
MIN_OPTION_LIQUIDITY=50     # Minimum option volume required to trade
AUTO_MIN_CONFIDENCE=0.55
AUTO_RISK_FRACTION=0.02
AUTO_MAX_POSITIONS=1
AUTO_ACCOUNT_EQUITY=150
AUTO_INTERVAL_SECONDS=60
AUTO_INCLUDE_NEWS=0
AUTO_USE_CACHE=0
AUTO_USE_SNAPSHOT_STREAM=0
AUTO_STREAM_INTERVAL_SECONDS=60
AUTO_STREAM_FORCE_REFRESH=0
AUTO_USE_LIVE_STREAM=0
AUTO_STOP_LOSS_FRACTION=0.03
AUTO_TAKE_PROFIT_REWARD=2.5
MIN_OPTION_AGG_BARS=20
MIN_OPTION_AGG_VOLUME=50
MIN_OPTION_AGG_VWAP=0.02
NEWS_API_KEY=your_news_api_key
NEWS_SECRET_KEY=your_news_secret
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
MARKETAUX_API_KEY=your_marketaux_token
TARGET_TICKERS=["AAPL","MSFT","AMZN","GOOG","NVDA","META","TSLA","PLTR","OPEN","AMD","HOOD"]
LOG_LEVEL=INFO
